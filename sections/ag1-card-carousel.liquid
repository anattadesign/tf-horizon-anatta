<div
  class="ag1-card-carousel color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="ag1-card-carousel__container">
    {%- if section.settings.heading != blank or section.settings.button_label_1 != blank -%}
      <div class="ag1-card-carousel__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ag1-card-carousel__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="ag1-card-carousel__actions">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_url_1 != blank %}href="{{ section.settings.button_url_1 }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="ag1-card-carousel__cta button"
            >
              {{ section.settings.button_label_1 }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_url_2 != blank %}href="{{ section.settings.button_url_2 }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="ag1-card-carousel__cta button--secondary"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="ag1-card-carousel__viewport">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="ag1-card-carousel__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ag1-card-carousel__card-media">
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: '(min-width: 750px) 400px, 85vw',
                    widths: '375,550,750,800',
                    loading: 'lazy',
                    class: 'ag1-card-carousel__card-image',
                    alt: block.settings.image.alt
                }}
              </div>
            {%- endif -%}
            <div class="ag1-card-carousel__card-overlay"></div>
            {%- if block.settings.label != blank -%}
              <span class="ag1-card-carousel__card-label">{{ block.settings.label }}</span>
            {%- endif -%}
            <div class="ag1-card-carousel__card-content">
              {%- if block.settings.heading != blank -%}
                <h3 class="ag1-card-carousel__card-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="ag1-card-carousel__card-body">{{ block.settings.body }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ag1-card-carousel {
    padding-top: var(--section-padding-top, 80px);
    padding-bottom: var(--section-padding-bottom, 80px);
  }

  .ag1-card-carousel__container {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: 64px;
  }

  .ag1-card-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-block-end: 40px;
  }

  .ag1-card-carousel__heading {
    font-family: var(--font-heading--family);
    font-size: 48px;
    line-height: 1.1;
    color: var(--color-foreground);
  }

  .ag1-card-carousel__actions {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .ag1-card-carousel__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 24px;
    min-height: 48px;
    border-radius: 32px;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .ag1-card-carousel__cta.button {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
  }

  .ag1-card-carousel__cta.button:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
  }

  .ag1-card-carousel__cta.button--secondary {
    background: transparent;
    color: var(--color-secondary-button-text);
    box-shadow: var(--color-secondary-button-border) 0px 0px 0px 1px inset;
  }

  .ag1-card-carousel__cta.button--secondary:hover {
    background: var(--color-secondary-button-hover-background);
    color: var(--color-secondary-button-hover-text);
  }

  .ag1-card-carousel__cta:focus-visible {
    outline: 3px solid #46DE46;
    outline-offset: 2px;
  }

  .ag1-card-carousel__viewport {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 4px;
  }

  .ag1-card-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .ag1-card-carousel__card {
    position: relative;
    flex: 0 0 400px;
    aspect-ratio: 5 / 7;
    border-radius: 16px;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .ag1-card-carousel__card-media {
    position: absolute;
    inset: 0;
  }

  .ag1-card-carousel__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ag1-card-carousel__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 50%);
    z-index: 1;
  }

  .ag1-card-carousel__card-label {
    position: absolute;
    top: 24px;
    inset-inline-start: 24px;
    z-index: 2;
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 6px 12px;
    border-radius: 100px;
  }

  .ag1-card-carousel__card-content {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    z-index: 2;
    padding: 24px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ag1-card-carousel__card-heading {
    font-family: var(--font-heading--family);
    font-size: 24px;
    line-height: 1.2;
    color: #fff;
    margin-block-end: 8px;
  }

  .ag1-card-carousel__card-body {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  @media screen and (max-width: 749px) {
    .ag1-card-carousel__container {
      padding-inline: 24px;
    }

    .ag1-card-carousel__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-block-end: 24px;
    }

    .ag1-card-carousel__heading {
      font-size: 32px;
    }

    .ag1-card-carousel__card {
      flex: 0 0 85vw;
    }

    .ag1-card-carousel__actions {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ag1_card_carousel",
  "tag": "section",
  "class": "ag1-card-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What makes AG1 so powerful"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_url_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_url_2",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.ag1_card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.ag1_card_carousel",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Card 1"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Card 2"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Card 3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
