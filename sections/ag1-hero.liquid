{%- liquid
  assign section_height = section.settings.section_height
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<div
  class="ag1-hero color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --overlay-opacity: {{ overlay_opacity }};
    {% if section_height != 'auto' %}--section-height: {{ section_height }};{% endif %}
  "
>
  <div class="ag1-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, class: 'ag1-hero__video' }}
    {%- elsif section.settings.image != blank -%}
      {%- assign sizes_val = '100vw' -%}
      {{
        section.settings.image
        | image_url: width: section.settings.image.width
        | image_tag:
          sizes: sizes_val,
          widths: '375,750,1100,1500,1920,2400',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'ag1-hero__image',
          alt: section.settings.image.alt
      }}
    {%- endif -%}
    <div class="ag1-hero__overlay"></div>
  </div>

  <div class="ag1-hero__container">
    <div class="ag1-hero__content">
      {%- assign buttons_group_open = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'button' and buttons_group_open -%}
          </div>
          {%- assign buttons_group_open = false -%}
        {%- endif -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
            <div class="ag1-hero__rating" {{ block.shopify_attributes }}>
              <span class="ag1-hero__stars" aria-hidden="true">
                {%- for i in (1..block.settings.stars) -%}
                  <svg class="ag1-hero__star" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {%- endfor -%}
              </span>
              {%- if block.settings.text != blank -%}
                <span class="ag1-hero__rating-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </div>

          {%- when 'heading' -%}
            <h1 class="ag1-hero__heading" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </h1>

          {%- when 'subtitle' -%}
            <p class="ag1-hero__subtitle" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>

          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              {%- unless buttons_group_open -%}
                <div class="ag1-hero__buttons">
                {%- assign buttons_group_open = true -%}
              {%- endunless -%}
              <div class="ag1-hero__button-wrapper" {{ block.shopify_attributes }}>
                <a
                  {% if block.settings.url != blank %}href="{{ block.settings.url }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="ag1-hero__cta {{ block.settings.style_class }}"
                >
                  {{ block.settings.label }}
                </a>
              </div>
            {%- endif -%}

          {%- when 'trust_badge' -%}
            {%- comment -%}Trust badges are rendered in the bottom bar below{%- endcomment -%}

        {%- endcase -%}
      {%- endfor -%}
      {%- if buttons_group_open -%}</div>{%- endif -%}
    </div>

    <div class="ag1-hero__trust-bar">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_badge' -%}
          <div class="ag1-hero__trust-badge" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="ag1-hero__trust-icon">
                {{
                  block.settings.icon
                  | image_url: width: 24
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.text,
                    class: 'ag1-hero__trust-icon-img'
                }}
              </span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="ag1-hero__trust-text">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ag1-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--section-height, auto);
    min-height: 500px;
    padding-top: var(--section-padding-top, 0px);
    padding-bottom: var(--section-padding-bottom, 0px);
  }

  .ag1-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ag1-hero__video,
  .ag1-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ag1-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, var(--overlay-opacity, 0.4)), rgba(0, 0, 0, calc(var(--overlay-opacity, 0.4) + 0.1)));
    z-index: 1;
  }

  .ag1-hero__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: 64px;
    display: flex;
    flex-direction: column;
    min-height: inherit;
    height: inherit;
  }

  .ag1-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    max-width: 900px;
    margin: 0 auto;
    padding-block-start: 60px;
    padding-block-end: 160px;
  }

  .ag1-hero__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-bottom: 16px;
  }

  .ag1-hero__stars {
    display: flex;
    gap: 4px;
    color: #46DE46;
  }

  .ag1-hero__star {
    width: 16px;
    height: 16px;
  }

  .ag1-hero__rating-text {
    font-size: var(--font-size--xs);
    line-height: 1.5;
    color: var(--color-foreground);
  }

  .ag1-hero__heading {
    font-family: var(--font-accent--family);
    font-size: 72px;
    line-height: 0.95;
    text-align: center;
    color: var(--color-foreground);
    margin-block: 16px 0;
  }

  .ag1-hero__subtitle {
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 1.55;
    text-align: center;
    color: var(--color-foreground);
    max-width: 900px;
    margin-block-start: 24px;
  }

  .ag1-hero__buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-block-start: 24px;
  }

  .ag1-hero__button-wrapper {
    display: inline-flex;
  }

  .ag1-hero__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 20px;
    min-height: 52px;
    border-radius: 32px;
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 24px;
    text-align: center;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .ag1-hero__cta.button {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
  }

  .ag1-hero__cta.button:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
  }

  .ag1-hero__cta.button--secondary {
    background: transparent;
    color: var(--color-secondary-button-text);
    box-shadow: var(--color-secondary-button-border) 0px 0px 0px 1px inset;
  }

  .ag1-hero__cta.button--secondary:hover {
    background: var(--color-secondary-button-hover-background);
    color: var(--color-secondary-button-hover-text);
  }

  .ag1-hero__cta:focus-visible {
    outline: 3px solid #46DE46;
    outline-offset: 2px;
  }

  .ag1-hero__trust-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px 48px;
    padding: 24px 64px 32px;
  }

  .ag1-hero__trust-badge {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ag1-hero__trust-icon-img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .ag1-hero__trust-text {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .ag1-hero {
      min-height: 400px;
    }

    .ag1-hero__container {
      padding-inline: 24px;
    }

    .ag1-hero__content {
      padding-block-start: 40px;
      padding-block-end: 140px;
    }

    .ag1-hero__heading {
      font-size: 40px;
    }

    .ag1-hero__subtitle {
      font-size: 16px;
    }

    .ag1-hero__trust-bar {
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 16px 24px 24px;
    }

    .ag1-hero__cta {
      font-size: 16px;
      padding: 12px 18px;
      min-height: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ag1_hero",
  "tag": "section",
  "class": "ag1-hero-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "100vh", "label": "Full screen" },
        { "value": "80vh", "label": "80%" },
        { "value": "60vh", "label": "60%" }
      ],
      "default": "80vh"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-6"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "t:names.ag1_rating",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "text",
          "label": "Review text",
          "default": "10,000+ verified 5-star reviews"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:names.heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "The #1 Daily Health Drink"
        }
      ]
    },
    {
      "type": "subtitle",
      "name": "t:names.subheading",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Subtitle"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:names.button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop AG1"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style_class",
          "label": "Style",
          "options": [
            { "value": "button", "label": "t:options.button_primary" },
            { "value": "button--secondary", "label": "t:options.button_secondary" }
          ],
          "default": "button"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "t:names.ag1_trust_badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Backed by science"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.ag1_hero",
      "blocks": [
        {
          "type": "rating",
          "settings": {
            "stars": 5,
            "text": "10,000+ verified 5-star reviews"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "The #1 Daily Health Drink"
          }
        },
        {
          "type": "subtitle"
        },
        {
          "type": "button",
          "settings": {
            "label": "Shop AG1",
            "style_class": "button"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "See Our Studies",
            "style_class": "button--secondary"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "Backed by 6 clinical trials"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "NSF Certified for Sport®"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "Trusted by leading scientists"
          }
        }
      ]
    }
  ]
}
{% endschema %}
