<ag1-clinical-study
  class="ag1-clinical-study color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --callout-bg: {{ section.settings.callout_bg_color }};
    --callout-text: {{ section.settings.callout_text_color }};
    --divider-color: {{ section.settings.divider_color }};
  "
>
  <div class="ag1-clinical-study__container">
    <div class="ag1-clinical-study__row">
      {%- comment -%} Left column — sticky title + CTA {%- endcomment -%}
      <div class="ag1-clinical-study__col-left">
        <div class="ag1-clinical-study__sticky">
          {%- if section.settings.label != blank -%}
            <p class="ag1-clinical-study__label">{{ section.settings.label }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="ag1-clinical-study__heading">
              {{ section.settings.heading }}
              {%- if section.settings.heading_superscript != blank -%}
                <sup class="ag1-clinical-study__superscript">{{ section.settings.heading_superscript }}</sup>
              {%- endif -%}
            </h2>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="ag1-clinical-study__cta"
            >
              <span>{{ section.settings.button_label }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Spacer column {%- endcomment -%}
      <div class="ag1-clinical-study__col-spacer"></div>

      {%- comment -%} Right column — comparison + callout {%- endcomment -%}
      <div class="ag1-clinical-study__col-right">
        <div class="ag1-clinical-study__content">
          {%- if section.settings.stat_number != blank -%}
            <div class="ag1-clinical-study__stat ag1-clinical-study__animate">
              <span class="ag1-clinical-study__stat-number" data-stat-number="{{ section.settings.stat_number }}">0</span>
              {%- if section.settings.stat_suffix != blank -%}
                <span class="ag1-clinical-study__stat-suffix">{{ section.settings.stat_suffix }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.image_before != blank or section.settings.image_after != blank -%}
            <div class="ag1-clinical-study__comparison ag1-clinical-study__animate">
              {%- if section.settings.image_before != blank -%}
                <div class="ag1-clinical-study__comparison-col">
                  <p class="ag1-clinical-study__comparison-label">{{ section.settings.image_before_label }}</p>
                  <div class="ag1-clinical-study__comparison-media">
                    {{
                      section.settings.image_before
                      | image_url: width: section.settings.image_before.width
                      | image_tag:
                        sizes: '(min-width: 750px) 30vw, 45vw',
                        widths: '200,300,400,600,800',
                        loading: 'lazy',
                        class: 'ag1-clinical-study__comparison-img',
                        alt: section.settings.image_before.alt
                    }}
                  </div>
                </div>
              {%- endif -%}

              {%- if section.settings.image_after != blank -%}
                <div class="ag1-clinical-study__comparison-col">
                  <p class="ag1-clinical-study__comparison-label">{{ section.settings.image_after_label }}</p>
                  <div class="ag1-clinical-study__comparison-media">
                    {{
                      section.settings.image_after
                      | image_url: width: section.settings.image_after.width
                      | image_tag:
                        sizes: '(min-width: 750px) 30vw, 45vw',
                        widths: '200,300,400,600,800',
                        loading: 'lazy',
                        class: 'ag1-clinical-study__comparison-img',
                        alt: section.settings.image_after.alt
                    }}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.callout_text != blank -%}
            <div class="ag1-clinical-study__callout ag1-clinical-study__animate">
              <div class="ag1-clinical-study__callout-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="2"/>
                  <path d="M12 11v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="12" cy="7.5" r="1.25" fill="currentColor"/>
                </svg>
              </div>
              <div class="ag1-clinical-study__callout-text">
                {{ section.settings.callout_text }}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</ag1-clinical-study>

<script src="{{ 'ag1-clinical-study.js' | asset_url }}" defer></script>

{% stylesheet %}
  .ag1-clinical-study {
    padding-top: var(--section-padding-top, 0px);
    padding-bottom: var(--section-padding-bottom, 0px);
  }

  .ag1-clinical-study__container {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: 64px;
  }

  .ag1-clinical-study__row {
    display: flex;
    flex-wrap: wrap;
  }

  .ag1-clinical-study__col-left {
    position: relative;
    padding: 0 18px;
    max-width: 33.3333%;
    flex-shrink: 0;
    flex-basis: 33.3333%;
  }

  .ag1-clinical-study__sticky {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 60px 0;
    z-index: 1;
  }

  .ag1-clinical-study__label {
    font-family: var(--font-subheading--family);
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .ag1-clinical-study__heading {
    font-family: var(--font-heading--family);
    font-size: 56px;
    line-height: 56px;
    letter-spacing: -1.68px;
    color: var(--color-foreground);
  }

  .ag1-clinical-study__superscript {
    font-size: 0.45em;
    vertical-align: super;
    line-height: 0;
  }

  .ag1-clinical-study__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 20px;
    min-height: 52px;
    align-self: flex-start;
    border-radius: 32px;
    box-shadow: currentColor 0px 0px 0px 1px inset;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 24px;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }

  .ag1-clinical-study__cta:hover {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .ag1-clinical-study__cta:focus-visible {
    outline: 3px solid #46DE46;
    outline-offset: 2px;
  }

  .ag1-clinical-study__col-spacer {
    position: relative;
    padding: 0 18px;
    max-width: 8.33333%;
    flex-shrink: 0;
    flex-basis: 8.33333%;
  }

  .ag1-clinical-study__col-right {
    position: relative;
    padding: 0 18px;
    max-width: 58.3333%;
    flex-shrink: 0;
    flex-basis: 58.3333%;
  }

  .ag1-clinical-study__content {
    display: flex;
    flex-direction: column;
    padding-top: 24px;
    margin: 60px 0;
    border-top: 1px solid var(--divider-color, #CDD2CF);
  }

  .ag1-clinical-study__stat {
    display: flex;
    align-items: baseline;
    margin-bottom: 40px;
  }

  .ag1-clinical-study__stat-number {
    font-family: var(--font-heading--family);
    font-size: 72px;
    line-height: 1;
    color: var(--color-foreground);
    letter-spacing: -0.02em;
  }

  .ag1-clinical-study__stat-suffix {
    font-family: var(--font-heading--family);
    font-size: 48px;
    line-height: 1;
    color: var(--color-foreground);
    letter-spacing: -0.02em;
  }

  .ag1-clinical-study__comparison {
    display: flex;
    gap: 24px;
    margin-bottom: 40px;
  }

  .ag1-clinical-study__comparison-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ag1-clinical-study__comparison-label {
    font-family: var(--font-subheading--family);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  .ag1-clinical-study__comparison-media {
    position: relative;
    overflow: hidden;
  }

  .ag1-clinical-study__comparison-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ag1-clinical-study__callout {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 24px;
    background: var(--callout-bg, #0C3D3D);
    color: var(--callout-text, #FFFFFF);
    border-radius: 4px;
  }

  .ag1-clinical-study__callout-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: var(--callout-text, #FFFFFF);
  }

  .ag1-clinical-study__callout-icon svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  .ag1-clinical-study__callout-text {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    color: var(--callout-text, #FFFFFF);
  }

  .ag1-clinical-study__callout-text p {
    margin: 0;
  }

  /* Animation styles */
  .ag1-clinical-study__animate {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .ag1-clinical-study.is-visible .ag1-clinical-study__animate {
    opacity: 1;
    transform: translateY(0);
  }

  .ag1-clinical-study.is-visible .ag1-clinical-study__comparison {
    transition-delay: 0.2s;
  }

  .ag1-clinical-study.is-visible .ag1-clinical-study__callout {
    transition-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .ag1-clinical-study__animate {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ag1-clinical-study__container {
      padding-inline: 24px;
    }

    .ag1-clinical-study__row {
      flex-direction: column;
    }

    .ag1-clinical-study__col-left {
      max-width: 100%;
      flex-basis: 100%;
      padding: 0;
    }

    .ag1-clinical-study__sticky {
      position: static;
      padding: 40px 0 0;
    }

    .ag1-clinical-study__heading {
      font-size: 36px;
      line-height: 38px;
      letter-spacing: -1px;
    }

    .ag1-clinical-study__col-spacer {
      display: none;
    }

    .ag1-clinical-study__col-right {
      max-width: 100%;
      flex-basis: 100%;
      padding: 0;
    }

    .ag1-clinical-study__content {
      margin: 32px 0;
    }

    .ag1-clinical-study__stat-number {
      font-size: 48px;
    }

    .ag1-clinical-study__stat-suffix {
      font-size: 32px;
    }

    .ag1-clinical-study__comparison {
      gap: 16px;
    }

    .ag1-clinical-study__cta {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ag1_clinical_study",
  "tag": "section",
  "class": "ag1-clinical-study-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "NUTRITIONAL GAPS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "AG1 Next Gen is clinically shown to fill common nutrient gaps even in healthy eaters."
    },
    {
      "type": "text",
      "id": "heading_superscript",
      "label": "t:settings.heading_superscript",
      "default": "14"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.button_link"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "t:settings.image_before"
    },
    {
      "type": "text",
      "id": "image_before_label",
      "label": "t:settings.image_before_label",
      "default": "AFTER PLACEBO"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "t:settings.image_after"
    },
    {
      "type": "text",
      "id": "image_after_label",
      "label": "t:settings.image_after_label",
      "default": "AFTER AG1 NEXT GEN"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "richtext",
      "id": "callout_text",
      "label": "t:settings.callout_text"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "t:settings.stat_number"
    },
    {
      "type": "text",
      "id": "stat_suffix",
      "label": "t:settings.stat_suffix"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:settings.enable_animation",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "callout_bg_color",
      "label": "t:settings.callout_bg_color",
      "default": "#0C3D3D"
    },
    {
      "type": "color",
      "id": "callout_text_color",
      "label": "t:settings.callout_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "default": "#CDD2CF"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.ag1_clinical_study"
    }
  ]
}
{% endschema %}
