<div
  class="ag1-flavor-accordion-section color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding-block-start }}px;
    --section-padding-bottom: {{ section.settings.padding-block-end }}px;
    --accordion-height: {{ section.settings.section_height }}px;
  "
>
  <div class="ag1-flavor-accordion-section__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="ag1-flavor-accordion-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ag1-flavor-accordion class="ag1-flavor-accordion">
      {%- for block in section.blocks -%}
        {%- if block.type == 'panel' -%}
          <div
            class="ag1-flavor-panel{% if forloop.first %} active{% endif %}"
            {{ block.shopify_attributes }}
            tabindex="0"
            role="button"
            aria-label="{{ block.settings.label | escape }}"
          >
            {%- if block.settings.image != blank -%}
              <div class="ag1-flavor-panel__media">
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    widths: '375,550,750,1100,1500',
                    loading: 'lazy',
                    class: 'ag1-flavor-panel__image',
                    alt: block.settings.label
                }}
              </div>
            {%- endif -%}

            <div class="ag1-flavor-panel__collapsed">
              <span class="ag1-flavor-panel__label">{{ block.settings.label }}</span>
            </div>

            <div class="ag1-flavor-panel__expanded">
              {%- if block.settings.heading != blank -%}
                <h3 class="ag1-flavor-panel__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="ag1-flavor-panel__body">{{ block.settings.body }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_url != blank %}href="{{ block.settings.button_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="ag1-flavor-panel__cta"
                >
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </ag1-flavor-accordion>
  </div>
</div>

{% stylesheet %}
  .ag1-flavor-accordion-section {
    padding-top: var(--section-padding-top, 80px);
    padding-bottom: var(--section-padding-bottom, 80px);
  }

  .ag1-flavor-accordion-section__container {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: 64px;
  }

  .ag1-flavor-accordion-section__heading {
    font-family: var(--font-heading--family);
    font-size: 48px;
    line-height: 1.1;
    text-align: center;
    color: var(--color-foreground);
    margin-block-end: 48px;
  }

  .ag1-flavor-accordion {
    display: flex;
    gap: 24px;
    height: var(--accordion-height, 720px);
  }

  .ag1-flavor-panel {
    position: relative;
    flex: 1;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ag1-flavor-panel:focus-visible {
    outline: 3px solid #46DE46;
    outline-offset: 2px;
  }

  .ag1-flavor-panel.active {
    flex: 3;
  }

  .ag1-flavor-panel__media {
    position: absolute;
    inset: 0;
  }

  .ag1-flavor-panel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ag1-flavor-panel__collapsed {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    transition: opacity 0.3s;
    z-index: 1;
  }

  .ag1-flavor-panel.active .ag1-flavor-panel__collapsed {
    opacity: 0;
    pointer-events: none;
  }

  .ag1-flavor-panel__label {
    font-family: var(--font-heading--family);
    font-size: 24px;
    color: #fff;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: writing-mode 0.3s, transform 0.3s;
  }

  .ag1-flavor-panel.active .ag1-flavor-panel__label {
    writing-mode: horizontal-tb;
    transform: none;
  }

  .ag1-flavor-panel__expanded {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    z-index: 2;
    padding: 32px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s 0.15s, transform 0.4s 0.15s;
  }

  .ag1-flavor-panel.active .ag1-flavor-panel__expanded {
    opacity: 1;
    transform: translateY(0);
  }

  .ag1-flavor-panel__heading {
    font-family: var(--font-heading--family);
    font-size: 32px;
    line-height: 1.1;
    color: #fff;
    margin-block-end: 12px;
  }

  .ag1-flavor-panel__body {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin-block-end: 20px;
  }

  .ag1-flavor-panel__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 12px 20px;
    min-height: 44px;
    border-radius: 32px;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .ag1-flavor-panel__cta:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
  }

  .ag1-flavor-panel__cta:focus-visible {
    outline: 3px solid #46DE46;
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ag1-flavor-accordion-section__container {
      padding-inline: 24px;
    }

    .ag1-flavor-accordion-section__heading {
      font-size: 32px;
      margin-block-end: 32px;
    }

    .ag1-flavor-accordion {
      flex-direction: column;
      height: auto;
    }

    .ag1-flavor-panel {
      min-height: 200px;
      transition: min-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ag1-flavor-panel.active {
      min-height: 480px;
    }

    .ag1-flavor-panel__label {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .ag1-flavor-panel__heading {
      font-size: 24px;
    }

    .ag1-flavor-panel__expanded {
      padding: 24px;
    }
  }
{% endstylesheet %}

<script src="{{ 'ag1-flavor-accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.ag1_flavor_accordion",
  "tag": "section",
  "class": "ag1-flavor-accordion-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the flavors"
    },
    {
      "type": "number",
      "id": "section_height",
      "label": "Desktop height (px)",
      "default": 720
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "t:names.ag1_panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Flavor"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Flavor name"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.ag1_flavor_accordion",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "label": "Original",
            "heading": "Original",
            "body": "The one that started it all. A refreshing, subtly sweet flavor.",
            "button_label": "Shop Original"
          }
        },
        {
          "type": "panel",
          "settings": {
            "label": "Berry",
            "heading": "Berry",
            "body": "A delicious berry blend with a smooth finish.",
            "button_label": "Shop Berry"
          }
        },
        {
          "type": "panel",
          "settings": {
            "label": "Citrus",
            "heading": "Citrus",
            "body": "Bright and zesty citrus flavor to start your day.",
            "button_label": "Shop Citrus"
          }
        }
      ]
    }
  ]
}
{% endschema %}
