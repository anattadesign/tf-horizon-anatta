{% doc %}
  Block: Custom Icon

  Description:
    A responsive icon block with preset SVG icons or custom image upload,
    independent desktop/mobile sizing, rotation, color override (inherit,
    color scheme, or custom), margin controls, and optional link wrapper.

  Settings:
    Icon:
    - icon (select): Preset icon grouped by category (General, Food & Dietary,
      Fashion & Care, Commerce, Nature & Eco, Social) or "Custom" to upload
      an image. Default: "price_tag"
    - image_upload (image_picker): Custom image icon. Visible when icon is "custom".
    - rotate (select): Rotation in 45° increments (0° to 180°, -45° to -135°). Default: "0"

    Desktop size (750px and above):
    - width_desktop (range): Icon width 12–200px. Default: 24
    - margin_top_desktop (number): Top margin in px. Default: 0
    - margin_bottom_desktop (number): Bottom margin in px. Default: 0

    Mobile size (below 750px):
    - width_mobile (range): Icon width 12–200px. Default: 24
    - margin_top_mobile (number): Top margin in px. Default: 0
    - margin_bottom_mobile (number): Bottom margin in px. Default: 0

    Color:
    - color_source (select): inherit, color_scheme, or custom. Default: "inherit"
    - color_scheme (color_scheme): Visible when color_source is "color_scheme".
    - color (color): Custom color picker. Visible when color_source is "custom".

    Link:
    - link (url): Optional link wrapping the icon.
    - open_in_new_tab (checkbox): Open link in new tab. Default: false

  Notes:
    - Desktop breakpoint is 750px (Horizon convention).
    - Icon options use Shopify's group attribute for organized dropdown categories.
    - When "Custom" is selected, the icon name is mapped to "none" internally so
      the icon-or-image snippet renders the uploaded image.
    - Rotation is applied via CSS transform on the icon media element.
    - Custom color only applies when color_source is set to "custom".
{% enddoc %}

{% liquid
  assign s = block.settings
  assign icon_name = s.icon
  assign icon_image = nil
  if icon_name == 'custom'
    assign icon_name = 'none'
    assign icon_image = s.image_upload
  endif
%}

{% capture icon_element %}
  {% render 'icon-or-image',
    icon: icon_name,
    image_upload: icon_image,
    width: s.width_desktop,
    class_name: 'custom-icon__media',
    attributes: block.shopify_attributes
  %}
{% endcapture %}

{% capture styles %}
  --ci-width-desktop: {{ s.width_desktop }}px;
  --ci-width-mobile: {{ s.width_mobile }}px;
  --ci-mt-desktop: {{ s.margin_top_desktop | default: 0 }}px;
  --ci-mb-desktop: {{ s.margin_bottom_desktop | default: 0 }}px;
  --ci-mt-mobile: {{ s.margin_top_mobile | default: 0 }}px;
  --ci-mb-mobile: {{ s.margin_bottom_mobile | default: 0 }}px;
  {% if s.rotate != '0' %}
    --ci-rotate: {{ s.rotate }}deg;
  {% endif %}
  {% if s.color != blank %}
    --ci-color: {{ s.color }};
  {% endif %}
{% endcapture %}

{% capture classes %}
  custom-icon
  {% if s.color_source == 'color_scheme' %}color-{{ s.color_scheme }}{% endif %}
  {% if s.color_source == 'custom' and s.color != blank %}custom-icon--custom-color{% endif %}
{% endcapture %}

<div
  class="{{ classes | strip_newlines | strip }}"
  style="{{ styles | strip_newlines | strip }}"
>
  {%- if s.link != blank -%}
    <a
      href="{{ s.link }}"
      class="custom-icon__link"
      {% if s.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
    >
      {{ icon_element }}
    </a>
  {%- else -%}
    {{ icon_element }}
  {%- endif -%}
</div>

{% stylesheet %}
  .custom-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: var(--horizontal-alignment, inline-start);
    margin-top: var(--ci-mt-mobile);
    margin-bottom: var(--ci-mb-mobile);
  }

  .custom-icon__media {
    width: var(--ci-width-mobile);
    height: auto;
    transform: rotate(var(--ci-rotate, 0deg));
  }

  .custom-icon__link {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }

  .custom-icon--custom-color,
  .custom-icon--custom-color .custom-icon__media {
    color: var(--ci-color);
  }

  @media screen and (min-width: 750px) {
    .custom-icon {
      margin-top: var(--ci-mt-desktop);
      margin-bottom: var(--ci-mb-desktop);
    }

    .custom-icon__media {
      width: var(--ci-width-desktop);
    }
  }
{% endstylesheet %}

