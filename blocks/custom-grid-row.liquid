{% doc %}
  Block: Custom Grid Row

  Description:
    A 12-column CSS grid container. Place Custom Grid Col blocks inside to
    define how content spans across columns. Use this as the direct parent
    of any Custom Grid Col blocks.

  Settings:
    Desktop styles (apply at 750px and above):
    - row_gap_desktop (number): Vertical gap between rows in pixels. Default: 24
    - column_gap_desktop (number): Horizontal gap between columns in pixels. Default: 24
    - vertical_alignment_desktop (select): Vertical alignment of child columns.
        Options: start, center, end, stretch. Default: "start"

    Mobile styles (apply below 750px):
    - row_gap_mobile (number): Vertical gap between rows in pixels. Default: 12
    - column_gap_mobile (number): Horizontal gap between columns in pixels. Default: 12
    - vertical_alignment_mobile (select): Vertical alignment of child columns.
        Options: start, center, end, stretch. Default: "start"

  Usage example:
    1. Add a "Generic Section" to the page.
    2. Inside it, add a "Custom Grid Row" block.
    3. Inside the row, add two "Custom Grid Col" blocks — set each to span 6
       columns for a 50/50 split.
    4. Add content blocks (Custom Text, Custom Image, etc.) inside each col.

  Notes:
    - Always uses a 12-column grid. Column spans are controlled by the
      Custom Grid Col block, not here.
    - Only accepts _custom-grid-column blocks as direct children.
{% enddoc %}

{% liquid
  assign s = block.settings
%}

{% capture inline_styles %}
  --cgr-row-gap-mobile: {{ s.row_gap_mobile }}px;
  --cgr-col-gap-mobile: {{ s.column_gap_mobile }}px;
  --cgr-align-mobile: {{ s.vertical_alignment_mobile }};
  --cgr-row-gap-desktop: {{ s.row_gap_desktop }}px;
  --cgr-col-gap-desktop: {{ s.column_gap_desktop }}px;
  --cgr-align-desktop: {{ s.vertical_alignment_desktop }};
{% endcapture %}

{% stylesheet %}
  .custom-grid-row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    row-gap: var(--cgr-row-gap-mobile);
    column-gap: var(--cgr-col-gap-mobile);
    align-items: var(--cgr-align-mobile);
  }

  @media screen and (min-width: 750px) {
    .custom-grid-row {
      row-gap: var(--cgr-row-gap-desktop);
      column-gap: var(--cgr-col-gap-desktop);
      align-items: var(--cgr-align-desktop);
    }
  }
{% endstylesheet %}

<div
  class="custom-grid-row"
  data-grid-row
  style="{{ inline_styles | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Grid Row",
  "tag": null,
  "blocks": [
    { "type": "_custom-grid-column" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.desktop_styles"
    },
    {
      "type": "number",
      "id": "row_gap_desktop",
      "label": "t:settings.row_gap",
      "default": 24,
      "info": "Row gap in pixels (applies at 750px and above)"
    },
    {
      "type": "number",
      "id": "column_gap_desktop",
      "label": "t:settings.column_gap",
      "default": 24,
      "info": "Column gap in pixels (applies at 750px and above)"
    },
    {
      "type": "select",
      "id": "vertical_alignment_desktop",
      "label": "t:settings.y_position",
      "default": "start",
      "options": [
        { "value": "start",   "label": "t:options.top" },
        { "value": "center",  "label": "t:options.center" },
        { "value": "end",     "label": "t:options.bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    },
    {
      "type": "header",
      "content": "t:content.mobile_styles"
    },
    {
      "type": "number",
      "id": "row_gap_mobile",
      "label": "t:settings.row_gap",
      "default": 12,
      "info": "Row gap in pixels (applies below 750px)"
    },
    {
      "type": "number",
      "id": "column_gap_mobile",
      "label": "t:settings.column_gap",
      "default": 12,
      "info": "Column gap in pixels (applies below 750px)"
    },
    {
      "type": "select",
      "id": "vertical_alignment_mobile",
      "label": "t:settings.y_position",
      "default": "start",
      "options": [
        { "value": "start",   "label": "t:options.top" },
        { "value": "center",  "label": "t:options.center" },
        { "value": "end",     "label": "t:options.bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid Row",
      "category": "Layout",
      "blocks": [
        { "type": "_custom-grid-column" },
        { "type": "_custom-grid-column" }
      ]
    }
  ]
}
{% endschema %}
